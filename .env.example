# ── MedSuper Flutter App Environment Variables ────────────────────────────────
#
# Flutter reads compile-time environment variables passed via `--dart-define`
# or through launch configurations in VS Code / Android Studio.
#
# 1. Backend Base URL (NestJS API Origin)
# Point to your local NestJS backend ('http://localhost:3000' or 'http://10.0.2.2:3000' for Android Emulator).
# Leave unset to run in Mock Mode.
BASE_URL=

# To build the staging APK against the currently deployed API, pass this value
# with --dart-define=BASE_URL when running Flutter's build command. Do not put
# API credentials or server-side secrets in this file or in a Flutter build.
# Staging API: https://medsuper-api-69168697113.europe-west1.run.app

# 2. Environment Mode ('dev', 'staging', 'production')
ENV=dev

# 3. Firebase Web Push VAPID Key
# Required only if compiling/running on Flutter Web. Android & iOS use google-services.json automatically.
FCM_VAPID_KEY=
